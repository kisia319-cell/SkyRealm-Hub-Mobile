# Copy this file to .env in the same server folder, then replace all placeholders.
# Do not share .env or put SMTP_PASSWORD into the launcher / EXE.
DATABASE_URL=sqlite:///./skyrealm_auth.db

# Gmail example. Use a Google App Password, NOT your usual Google password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.sender@gmail.com
SMTP_PASSWORD=replace_with_16_character_google_app_password
SMTP_FROM=your.sender@gmail.com
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15

# When SMTP is configured, leave false so codes are emailed instead of printed.
# For local testing without SMTP only, set this to true.
DEV_PRINT_EMAIL_CODE=false

CODE_TTL_MINUTES=10
CODE_RESEND_SECONDS=60
MAX_CODE_ATTEMPTS=5
SESSION_TTL_DAYS=30
CORS_ALLOW_ORIGINS=*
